# ══════════════════════════════════════════════
# Calcifer.Shop — Environment Variables
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════

# ── Base URL ──────────────────────────────
NUXT_PUBLIC_SITE_URL=https://calcifer.shop

# ── API (if applicable) ──────────────────
NUXT_API_BASE_URL=
NUXT_API_SECRET=

# ── Analytics (optional) ─────────────────
NUXT_PUBLIC_GA_ID=
